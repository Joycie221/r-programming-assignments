library(ggplot2)

Name <- c("Jeb", "Donald", "Ted", "Marco", "Carly", "Hillary", "Bernie")
ABC_poll <- c(4, 62, 51, 21, 2, 14, 15)
CBS_poll <- c(12, 75, 43, 19, 1, 21, 19)

df_polls <- data.frame(Name, ABC_poll, CBS_poll)

str(df_polls)
head(df_polls)

mean_ABC <- mean(df_polls$ABC_poll)
median_CBS <- median(df_polls$CBS_poll)
overall_range <- range(df_polls[, c("ABC_poll", "CBS_poll")])

df_polls$Diff <- df_polls$CBS_poll - df_polls$ABC_poll

poll_plot <- ggplot(df_polls, aes(x = reorder(Name, Diff), y = Diff)) +
  geom_bar(stat = "identity", fill = "blue3") +
  theme_minimal() +
  labs(
    title = "Discrepancy Between CBS and ABC Polls by Candidate",
    subtitle = "Positive values mean CBS poll was higher; negative means ABC was higher",
    x = "Candidate",
    y = "Difference (CBS Poll - ABC Poll)"
  )

print(poll_plot)

ggsave("poll_differences.png", plot = poll_plot, width = 7, height = 5)
